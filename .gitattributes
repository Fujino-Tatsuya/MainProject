# Default text handling. Keep repository text files normalized by Git while
# binary Unity/imported assets stay untouched by the binary rules below.
* text=auto

# Source and project text files are UTF-8 by policy.
*.asmdef text
*.cginc text
*.cs text
*.css text
*.html text
*.inputactions text
*.json text
*.md text
*.shader text
*.shadergraph text
*.shadersubgraph text
*.tss text
*.txt text
*.uxml text
*.uss text
*.yaml text
*.yml text

# Unity YAML assets are text. Force LF: Unity itself writes these files with
# LF, so checking them out as CRLF makes every editor touch show up as
# "modified" with an empty diff. Measured 2026-08-23: five ProjectSettings and
# 99.Settings .asset files were dirty in git status while git diff --stat
# reported zero changed lines. Forcing LF removes that churn rather than
# adding it. The binary overrides below still win for .asset files Unity
# serializes as binary.
*.anim text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.unity text eol=lf
*.vfx text eol=lf

# Some .asset files are ALWAYS binary, even with Force Text serialization.
# Treating them as text corrupts them on checkout/merge (CRLF conversion,
# 3-way text merge). These override the *.asset rule above.
NavMesh*.asset binary
LightingData.asset binary
OcclusionCullingData.asset binary
INab*.asset binary

# Imported/binary assets.
*.dll binary
*.exe binary
*.fbx binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.pdf binary
*.png binary
*.psd binary
*.tga binary
*.ttf binary
*.unitypackage binary
*.wav binary
*.zip binary

Assets/Plugins/FMOD/**/*.bundle text eol=lf
Assets/Plugins/FMOD/**/Info.plist text eol=lf