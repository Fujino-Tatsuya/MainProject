  m_Script: {fileID: 11500000, guid: bd54aeaa9a9127f439106443ae8ea7d1, type: 3}
  m_Name: TraitTexts
  m_EditorClassIdentifier: Assembly-CSharp::TraitTextTable
  entries:
  - id: TUT_C1_TRAIT_TITLE
    text: "\uD2B9\uC131 \uC120\uD0DD"
  - id: TUT_C1_TRAIT_INTRO
    text: "\uD2B9\uC131\uC740 <b><color=#F2C14E>\uC774\uBC88 \uC791\uC804 \uB3D9\uC548\uB9CC</color></b>
      \uC720\uC9C0\uB418\uB294 \uAC15\uD654\uC785\uB2C8\uB2E4. \uAD6C\uC5ED\uC744
      \uB3CC\uD30C\uD560 \uB54C\uB9C8\uB2E4 \uBCF5\uB3C4\uC5D0\uC11C \uD558\uB098\uC529
      \uACE0\uB97C \uC218 \uC788\uACE0, \uC791\uC804\uC774 \uB05D\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
  - id: TUT_C4_TRAIT_LAST
    text: "\uC6D0\uD749\uACFC \uC2F8\uC6B0\uAE30 \uC804 \uB9C8\uC9C0\uB9C9 \uD2B9\uC131\uC785\uB2C8\uB2E4.
      \uAC8C\uC774\uC9C0\uB294 \uACC4\uC18D \uCC28\uC624\uB985\uB2C8\uB2E4."
  - id: TUT_C1_TRAIT_PICKED
    text: "\uD2B9\uC131\uC744 \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4. \uD68D\uB4DD\uD55C
      \uD2B9\uC131\uC740 {location}\uC5D0\uC11C \uB2E4\uC2DC \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: TUT_C1_TRAIT_PICKED_LOCATION
    text: "\uD654\uBA74 \uC67C\uCABD \uC704"
