  - id: TUT_Z1_ATTACK_HEAT
    text: "\uACC4\uC18D \uC3D8\uBA74 \uACFC\uC5F4\uC774 \uC313\uC785\uB2C8\uB2E4.
      \uAC00\uB4DD \uCC28\uBA74 \uC7A0\uC2DC \uACF5\uACA9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_PASSIVE_INFO_PALADIN
    text: "\uBC29\uAE08 \uCCAB \uACF5\uACA9\uC774 \uB354 \uAC15\uD558\uAC8C \uB4E4\uC5B4\uAC04
      \uAC83\uC774 \uD328\uC2DC\uBE0C [{P}] \uC785\uB2C8\uB2E4. \uC801\uC5D0\uAC8C
      \uB9DE\uC744\uC218\uB85D \uB354 \uBE68\uB9AC \uB2E4\uC2DC \uC900\uBE44\uB429\uB2C8\uB2E4."
    durationSeconds: 8
    sfx: {fileID: 0}
  - id: TUT_Z1_PASSIVE_INFO_GUNNER
    text: "[{P}] \uC3E0\uC218\uB85D \uACFC\uC5F4 \uB2E8\uACC4\uAC00 \uC624\uB974\uACE0
      \uACF5\uACA9\uC774 \uAC15\uD574\uC9C0\uC9C0\uB9CC, \uAC00\uB4DD \uCC28\uBA74
      \uACF5\uACA9\uC774 \uC7A0\uAE41\uB2C8\uB2E4."
    durationSeconds: 8
    sfx: {fileID: 0}
  - id: TUT_Z1_PASSIVE_INFO_ASSASSIN
    text: "[{P}] \uACF5\uACA9\uC744 \uB9DE\uD790\uC218\uB85D \uBD84\uB178\uAC00 \uCC28\uACE0,
      \uCDA9\uBD84\uD788 \uCC28\uBA74 <b>R</b> \uB85C \uBCC0\uC2E0\uD569\uB2C8\uB2E4.
      \uBCF4\uC2A4\uB294 \uB4F1 \uB4A4\uB97C \uCE58\uBA74 \uB354 \uC544\uD515\uB2C8\uB2E4."
    durationSeconds: 8
    sfx: {fileID: 0}
  - id: TUT_Z1_CHECK_MOVE
    text: "\uC774\uB3D9"
    durationSeconds: 6
    sfx: {fileID: 0}
