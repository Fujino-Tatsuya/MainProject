    sfx: {fileID: 0}
  - id: TUT_C_PICK
    text: "\uD2B9\uC131\uC744 \uD558\uB098 \uACE0\uB974\uC138\uC694"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_C_WAIT
    text: "\uD2B9\uC131 \uC120\uD0DD \uC644\uB8CC \u2014 \uB3D9\uB8CC\uB97C \uAE30\uB2E4\uB9BD\uB2C8\uB2E4"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_C_NEXT
    text: "\uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_C4_GO_PAD
    text: "\uBCF4\uC2A4\uBC29 \uC5D8\uB9AC\uBCA0\uC774\uD130 \uBC1C\uD310\uC73C\uB85C
      \uC774\uB3D9\uD558\uC138\uC694 (\uBBF8\uB2C8\uB9F5 \uBCF4\uC2A4 \uC544\uC774\uCF58)"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_WAIT_PARTY_NOAUTO
    text: "\uB3D9\uB8CC\uB97C \uAE30\uB2E4\uB9AC\uB294 \uC911 ({n}/{total})"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_Q
    text: "<b>Q</b> \uC2A4\uD0AC [{Q}]\uC744 \uC0AC\uC6A9\uD558\uC138\uC694 ({n}/1)"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_Q_GUNNER
    text: "<b>Q</b>\uB85C \uCDA9\uC804\uC744 \uC2DC\uC791\uD558\uACE0 <b>\uC88C\uD074\uB9AD</b>\uC73C\uB85C
      \uBC1C\uC0AC\uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_E
    text: "<b>E</b> \uC2A4\uD0AC [{E}]\uC744 \uC0AC\uC6A9\uD558\uC138\uC694 ({n}/1)"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_E_PALADIN
    text: "<b>E</b>\uB85C \uBC29\uC5B4 \uC790\uC138\uB97C \uCDE8\uD558\uC138\uC694.
      \uACF5\uACA9\uC744 \uB9C9\uC73C\uBA74 \uBC18\uACA9\uD569\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_E_GUNNER
    text: "<b>E</b>\uB85C \uB4A4\uB85C \uBB3C\uB7EC\uB098\uBA70 \uACFC\uC5F4\uC744
      \uC2DD\uD600 \uBCF4\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_E_ASSASSIN
    text: "<b>E</b>\uB85C \uB2E4\uC74C \uAE30\uBCF8 \uACF5\uACA9\uC744 \uAC15\uD654\uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_RMB
    text: "<b>\uC6B0\uD074\uB9AD</b> \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD558\uC138\uC694
      ({n}/1)"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_R
    text: "<b>R</b> \uAD81\uADF9\uAE30\uB97C \uC0AC\uC6A9\uD558\uC138\uC694 ({n}/1)"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_R_ASSASSIN
    text: "\uD5C8\uC218\uC544\uBE44\uB97C \uACF5\uACA9\uD574 \uBD84\uB178\uB97C \uBAA8\uC740
      \uB4A4 <b>R</b>\uB85C \uBCC0\uC2E0\uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_CHECK_Q
    text: "Q \uC2A4\uD0AC"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_CHECK_E
    text: "E \uC2A4\uD0AC"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_CHECK_RMB
    text: "\uC6B0\uD074\uB9AD \uC2A4\uD0AC"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z1_CHECK_R
    text: "R \uAD81\uADF9\uAE30"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_C1_COOLDOWN_RESET
    text: "\uBAA8\uB4E0 \uC2A4\uD0AC\uC758 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774
      \uCD08\uAE30\uD654\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    durationSeconds: 5
    sfx: {fileID: 0}
  - id: TUT_Z3_COUNTER_GOAL
    text: "\uB178\uB797\uAC8C \uBE5B\uB0A0 \uB54C \uAC00\uAE4C\uC774\uC5D0\uC11C
      \uC801\uC744 \uD5A5\uD574 <b>\uC6B0\uD074\uB9AD</b>\uC73C\uB85C \uAC04\uD30C\uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_PUSH_INTRO
    text: "\uC6B0\uD074\uB9AD\uC774 \uB2E4\uC2DC \uC900\uBE44\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      <b>\uBCBD \uBC18\uB300\uD3B8</b>\uC5D0\uC11C \uC801\uC744 \uD5A5\uD574 \uC6B0\uD074\uB9AD\uD558\uBA74
      \uBCBD\uC73C\uB85C \uBC00\uC5B4\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    durationSeconds: 7
    sfx: {fileID: 0}
  - id: TUT_Z3_PUSH_GOAL
    text: "\uCDE8\uC57D\uD55C \uC2A4\uD53C\uB108\uBD07\uC744 <b>\uC6B0\uD074\uB9AD\uC73C\uB85C
      \uBCBD\uC5D0 \uBD80\uB52A\uD788\uAC8C</b> \uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_PUSH_HINT
    text: "\uC544\uC9C1 \uBCBD\uC5D0 \uB2FF\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
      \uC704\uCE58\uB97C \uC7A1\uACE0 \uB2E4\uC2DC \uBC00\uC5B4\uB0B4\uC138\uC694.
      \uB3D9\uB8CC\uB3C4 \uC774\uC5B4\uC11C \uBC00 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    durationSeconds: 5
    sfx: {fileID: 0}
  - id: TUT_Z3_WALL_SUCCESS
    text: "\uBCBD \uCDA9\uB3CC! \uC5F0\uACC4 \uC131\uACF5 ({n}/{total})"
    durationSeconds: 4
    sfx: {fileID: 0}
  - id: TUT_Z3_RETURN
    text: "\uB2E4\uC74C \uC5F0\uC2B5\uC744 \uC900\uBE44\uD569\uB2C8\uB2E4."
    durationSeconds: 3
    sfx: {fileID: 0}
  - id: BOSS_RAID_OpeningDash
    text: "\uB3CC\uC9C4\uC774 <b>\uD30C\uB797\uAC8C</b> \uBE5B\uB098\uBA74 <b>\uC815\uBA74</b>\uC5D0\uC11C
      <b>\uC6B0\uD074\uB9AD</b>\uC73C\uB85C \uAC04\uD30C\uD558\uC138\uC694!"
    durationSeconds: 4
    sfx: {fileID: 0}
  - id: BOSS_RAID_ChargeGuide
    text: "\uB4DC\uB860 \uD45C\uC2DD\uC744 <b>\uC1A1\uC804\uD0D1 \uC704\uB85C</b>
      \uB04C\uACE0 \uAC00\uC11C \uB5A8\uC5B4\uB728\uB9AC\uC138\uC694! \uC9C1\uC811
      \uB54C\uB824\uB3C4 \uBD80\uC11C\uC9D1\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: BOSS_RAID_SelfDestructGuide
    text: "23\ud638\uac00 <b>\uc790\ud3ed</b>\uc744 \uc900\ube44\ud569\ub2c8\ub2e4! <b>\uacf5\uaca9</b>\ud574\uc11c <b>\uc2e4\ub4dc</b>\ub97c \ubd80\uc218\uc138\uc694!"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: BOSS_RAID_RelayGather
    text: "<b>6\uc2dc \uc548\uc804 \uad6c\uc5ed</b>\uc73c\ub85c \ubaa8\uc774\uc138\uc694!"
    durationSeconds: 5
    sfx: {fileID: 0}
  - id: BOSS_RAID_RelayGuide
    text: "\ub3cc\uc9c4\uc774 <b>\ud30c\ub797\uac8c</b> \ube5b\ub098\uba74 <b>\uc6b0\ud074\ub9ad</b>\uc73c\ub85c \ub9c9\uc544 23\ud638\ub97c <b>12\uc2dc \ubcbd</b>\uae4c\uc9c0 \ubc00\uc5b4\ub0b4\uc138\uc694! \ub9c9\uc740 \uc0ac\ub78c\uc740 \ub3d9\ub8cc \ucc28\ub840\ub97c \uae30\ub2e4\ub9bd\ub2c8\ub2e4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: BOSS_RAID_RelayRoundReset
    text: "\ub2e4\uc2dc \ubaa8\ub450 \uac04\ud30c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4!"
    durationSeconds: 3
    sfx: {fileID: 0}
  - id: BOSS_RAID_RelaySuccess
    text: "23\ud638\ub97c \ubcbd\uae4c\uc9c0 \ubc00\uc5b4\ub0c8\uc2b5\ub2c8\ub2e4! \uc9c0\uae08 \uacf5\uaca9\ud558\uc138\uc694!"
    durationSeconds: 4
    sfx: {fileID: 0}
  - id: BOSS_RAID_RelayFail
    text: "\ub3cc\uc9c4\uc744 \ud53c\ud558\uc138\uc694!"
    durationSeconds: 3
    sfx: {fileID: 0}
  - id: BOSS_RAID_ChainGuide
    text: "<b>\uc9c0\ubaa9\ub41c \uc0ac\ub78c</b>\uc774 \uc815\uba74\uc5d0\uc11c <b>\uc6b0\ud074\ub9ad</b>\uc73c\ub85c \uac04\ud30c\ud558\uc138\uc694!"
    durationSeconds: 5
    sfx: {fileID: 0}
  - id: BOSS_RAID_PushNorthGuide
    text: "<b>\uc1a1\uc804\ud0d1</b>\uc744 \ubd80\uc234 \ucc28\uc9d5\uc744 \ub04a\uace0, \uc4f0\ub7ec\uc9c4 23\ud638\ub97c <b>\uc6b0\ud074\ub9ad</b>\uc73c\ub85c <b>\uc704\ucabd \ub05d</b>\uae4c\uc9c0 \ubc00\uc5b4\ub0b4\uc138\uc694!"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: BOSS_RAID_PushNorthSuccess
    text: "23\ud638\ub97c \ub05d\uae4c\uc9c0 \ubc00\uc5b4\ub0c8\uc2b5\ub2c8\ub2e4! \uc9c0\uae08 \uacf5\uaca9\ud558\uc138\uc694!"
    durationSeconds: 4
    sfx: {fileID: 0}
