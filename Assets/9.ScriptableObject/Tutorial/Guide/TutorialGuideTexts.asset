    sfx: {fileID: 0}
  - id: TUT_Z3_INTRO
    text: "<b>\uAC04\uD30C(\uC778\uD130\uB7FD\uD2B8)</b> \u2014 \uC2A4\uD53C\uB108\uBD07\uC774
      \uD68C\uC804\uD558\uAE30 \uC9C1\uC804 <b>\uB178\uB797\uAC8C \uBE5B\uB098\uB294
      \uC21C\uAC04</b>, <b>\uBC14\uC9DD \uBD99\uC5B4</b> \uB9C8\uC6B0\uC2A4\uB97C
      \uC2A4\uD53C\uB108\uBD07\uC5D0 \uB450\uACE0 <b>\uC6B0\uD074\uB9AD</b> \uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_PRACTICE_NOTE
    text: "\uAC04\uD30C\uB97C \uC138 \uBC88 \uC131\uACF5\uD560 \uB54C\uAE4C\uC9C0
      \uC2A4\uD53C\uB108\uBD07\uC740 \uC4F0\uB7EC\uC9C0\uC9C0 \uC54A\uACE0, \uD68C\uC804
      \uACF5\uACA9\uB3C4 \uD53C\uD574\uB97C \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_GOAL
    text: "\uC2A4\uD53C\uB108\uBD07\uC744 \uAC04\uD30C\uD558\uC138\uC694 ({n}/{total})"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_GUNNER
    text: "\uAC70\uB108\uC758 \uAC04\uD30C\uB294 \uCD1D\uAD6C\uB85C \uCC0C\uB974\uB294
      \uADFC\uC811\uAE30\uC785\uB2C8\uB2E4. \uC4F0\uACE0 \uB098\uBA74 \uC0B4\uC9DD
      \uBC00\uB824\uB098\uB2C8 \uB2E4\uC2DC \uBD99\uC73C\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_MISS
    text: "\uBE57\uB098\uAC14\uC2B5\uB2C8\uB2E4 \u2014 \uB354 \uAC00\uAE4C\uC774,
      \uC2A4\uD53C\uB108\uBD07\uC744 \uD5A5\uD574."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_EARLY
    text: "\uC544\uC9C1\uC785\uB2C8\uB2E4 \u2014 \uB178\uB797\uAC8C \uBE5B\uB0A0
      \uB54C\uB9CC \uAC04\uD30C\uB429\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_FIRST_SUCCESS
    text: "\uAC04\uD30C \uC131\uACF5! \uC801\uC774 \uC7A0\uC2DC \uBE44\uD2C0\uAC70\uB9BD\uB2C8\uB2E4
      \u2014 \uC774\uB54C \uBAB0\uC544\uCE58\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_HINT
    text: "\uC694\uB839: \uB178\uB780\uBE5B\uC774 \uBCF4\uC774\uBA74 \uBC14\uB85C
      \uBD99\uC5B4\uC11C \uC6B0\uD074\uB9AD. \uAC04\uD30C\uB294 \uB2E4\uC2DC \uC4F0\uAE30\uAE4C\uC9C0
      \uBA87 \uCD08 \uAC78\uB9BD\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_REAL
    text: "\uC5F0\uC2B5 \uB05D. \uC774\uC81C \uC9C4\uC9DC\uC785\uB2C8\uB2E4! \uB178\uB780\uBE5B\uC774
      \uBCF4\uC774\uBA74 \uC5B8\uC81C\uB4E0 \uAC04\uD30C\uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z3_BOSS
    text: "[\uC2A4\uD53C\uB108\uBD07] \uC744 \uCC98\uCE58\uD558\uC138\uC694"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z4_LORE
    text: "[\uACBD\uACE0] \uC624\uB978\uCABD \uC544\uB798 \uAC8C\uC774\uC9C0\uAC00
      \uAC00\uB4DD \uCC28\uBA74, \uC784\uBB34\uC758 \uC131\uD328\uC640 \uAD00\uACC4\uC5C6\uC774
      <b>\uC138\uACC4\uC120\uC744 \uC5C9\uB9DD\uC73C\uB85C \uB9CC\uB4E0 \uC6D0\uD749</b>\uACFC
      \uC2F8\uC6B0\uAC8C \uB429\uB2C8\uB2E4."
    durationSeconds: 5
    sfx: {fileID: 0}
  - id: TUT_Z4_TIMER_HINT
    text: "\uAC8C\uC774\uC9C0\uAC00 \uB2E4 \uCC28\uAE30 \uC804\uC5D0 \uBCF4\uC2A4\uBC29
      \uC5D8\uB9AC\uBCA0\uC774\uD130\uC5D0 \uC624\uB974\uBA74 \uAC8C\uC774\uC9C0\uAC00
      \uBA48\uCDA5\uB2C8\uB2E4. \uBCF4\uC2A4\uBC29\uC73C\uB85C \uAC00\uB294 \uAE38\uC740
      \uC911\uAC04\uBCF4\uC2A4\uB97C \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uC5F4\uB9BD\uB2C8\uB2E4."
    durationSeconds: 5
    sfx: {fileID: 0}
  - id: TUT_Z4_START
    text: "\uAC8C\uC774\uC9C0\uAC00 \uCC28\uC624\uB974\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4."
    durationSeconds: 3
    sfx: {fileID: 0}
  - id: TUT_Z4_PANEL_INTRO
    text: "\uAD6C\uC5ED <b>\uB124 \uADC0\uD241\uC774\uC758 \uC81C\uC5B4 \uD328\uB110</b>\uC744
      \uAC00\uB3D9(<b>F</b>)\uD558\uBA74 \uC911\uC559 \uC12C\uC73C\uB85C \uAC00\uB294
      \uB2E4\uB9AC\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z4_PANEL_GOAL
    text: "\uC81C\uC5B4 \uD328\uB110 \uAC00\uB3D9 ({n}/{total})"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z4_PANEL_FIRST
    text: "\uD328\uB110 \uAC00\uB3D9! \uD328\uB110\uC740 \uB3D9\uB8CC\uC640 \uACF5\uC720\uB429\uB2C8\uB2E4."
    durationSeconds: 4
    sfx: {fileID: 0}
  - id: TUT_Z4_BRIDGE
    text: "\uB2E4\uB9AC\uAC00 \uC5F4\uB838\uC2B5\uB2C8\uB2E4. <b>\uACC4\uB2E8\uC73C\uB85C
      2\uCE35\uC5D0 \uC62C\uB77C</b> \uB2E4\uB9AC\uB97C \uAC74\uB108 \uC911\uC559
      \uC12C\uC73C\uB85C \uAC00\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z4_MIDBOSS
    text: "\uC911\uC559 \uC12C\uC758 \uC911\uAC04\uBCF4\uC2A4\uB97C \uCC98\uCE58\uD558\uC138\uC694"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_Z4_COUNTER_REMIND
    text: "\uB178\uB797\uAC8C \uBE5B\uB098\uBA74 \uAC04\uD30C \uAE30\uD68C\uC785\uB2C8\uB2E4."
    durationSeconds: 4
    sfx: {fileID: 0}
  - id: TUT_Z4_ULT
    text: "<b>R</b> \u2014 \uAD81\uADF9\uAE30\uB97C \uC368 \uBCF4\uC138\uC694."
    durationSeconds: 4
    sfx: {fileID: 0}
  - id: TUT_Z4_ULT_ASSASSIN
    text: "\uBD84\uB178\uAC00 \uCDA9\uBD84\uD788 \uCC3C\uB2E4\uBA74 <b>R</b> \uB85C
      \uBCC0\uC2E0\uD574 \uBCF4\uC138\uC694."
    durationSeconds: 4
    sfx: {fileID: 0}
  - id: TUT_Z4_CLEAR
    text: "\uAE38\uC774 \uC5F4\uB838\uC2B5\uB2C8\uB2E4."
    durationSeconds: 3
    sfx: {fileID: 0}
  - id: TUT_Z4_GO_BOSS
    text: "\uBCF5\uB3C4\uC5D0\uC11C \uB9C8\uC9C0\uB9C9 \uD2B9\uC131\uC744 \uACE0\uB978
      \uB4A4 \uBCF4\uC2A4\uBC29 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB85C \uC774\uB3D9\uD558\uC138\uC694
      (\uBBF8\uB2C8\uB9F5 \uBCF4\uC2A4 \uC544\uC774\uCF58)"
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_B_PAD_WARN
    text: "\uC5D8\uB9AC\uBCA0\uC774\uD130 \uBC1C\uD310\uC5D0 <b>\uB204\uAD6C\uB4E0</b>
      \uC62C\uB77C\uC11C\uBA74 3\uCD08 \uB4A4 <b>\uD30C\uD2F0 \uC804\uC6D0</b>\uC774
      \uBCF4\uC2A4\uBC29\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_B_PAD_COUNT
    text: "\uBCF4\uC2A4\uBC29\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4 \u2014 \uBC1C\uD310
      \uBC16\uC73C\uB85C \uB098\uAC00\uBA74 \uCDE8\uC18C\uB429\uB2C8\uB2E4."
    durationSeconds: 3
    sfx: {fileID: 0}
  - id: TUT_B_BOSS_FRONT_TIP
    text: "\uC6D0\uD749(23\uD638)\uC740 <b>\uC815\uBA74</b>\uC5D0\uC11C\uB9CC \uAC04\uD30C\uB429\uB2C8\uB2E4
      \u2014 \uB178\uB780\uBE5B\uC774 \uBCF4\uC774\uBA74 \uC55E\uC73C\uB85C \uB3CC\uC544\uAC00
      \uC6B0\uD074\uB9AD\uD558\uC138\uC694."
    durationSeconds: 6
    sfx: {fileID: 0}
