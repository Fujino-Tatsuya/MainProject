  m_Script: {fileID: 11500000, guid: 93839f1dcd98f8043adf3e51450ccdd2, type: 3}
  m_Name: TutorialGuideTexts
  m_EditorClassIdentifier: Assembly-CSharp::TutorialGuideTextTable
  rows:
  - id: TUT_S0_WELCOME
    text: "\uC791\uC804 \uAD6C\uC5ED\uC5D0 \uC9C4\uC785\uD588\uC2B5\uB2C8\uB2E4.
      \uAE30\uBCF8 \uC870\uC791\uBD80\uD130 \uC810\uAC80\uD569\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_ZONE_CLEAR
    text: "\uAD6C\uC5ED \uD655\uBCF4. \uB2E4\uC74C \uBCF5\uB3C4\uAC00 \uC5F4\uB838\uC2B5\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_TIP_R_CANCEL
    text: "R(\uAD81\uADF9\uAE30)\uC740 \uB300\uC0C1\uC744 \uC9C0\uC815\uD558\uB294
      \uB3D9\uC548 \uC88C\uD074\uB9AD\uC73C\uB85C \uD655\uC815\uD569\uB2C8\uB2E4.
      \uCDE8\uC18C\uB294 R \uC744 \uB2E4\uC2DC \uB204\uB974\uAC70\uB098 \uC6B0\uD074\uB9AD."
    durationSeconds: 8
    sfx: {fileID: 0}
  - id: TUT_TIMER_EXPIRED
    text: "\uC2DC\uAC04\uC774 \uB2E4 \uB418\uC5C8\uC2B5\uB2C8\uB2E4 \u2014 \uC6D0\uD749\uC774
      \uAE30\uB2E4\uB9BD\uB2C8\uB2E4."
    durationSeconds: 6
    sfx: {fileID: 0}
  - id: TUT_WAIT_PARTY
    text: "\uB3D9\uB8CC\uB97C \uAE30\uB2E4\uB9AC\uB294 \uC911 ({n}/{total}) \xB7
      {mm:ss} \uD6C4 \uC790\uB3D9 \uC9C4\uD589"
    durationSeconds: 6
    sfx: {fileID: 0}
