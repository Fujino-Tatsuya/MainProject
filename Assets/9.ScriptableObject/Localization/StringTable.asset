  - key: UGS_INIT_FAILED
    ko: "Unity Services \uCD08\uAE30\uD654 \uB610\uB294 \uC775\uBA85 \uB85C\uADF8\uC778\uC5D0
      \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
